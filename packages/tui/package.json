{
	"name": "tui",
	"version": "0.0.0",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc --noEmit && bun build ./source/cli.tsx --target=bun --packages=external --outdir=dist",
		"dev": "tsc --watch",
		"cli": "bun source/cli.tsx",
		"test": "prettier --check . && xo && ava",
		"test:agent": "bun test ./test/app.test.tsx"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"ink": "^6.7.0",
		"ink-big-text": "^2.0.0",
		"ink-scroll-list": "^0.4.1",
		"meow": "^11.0.0",
		"oh-my-logo": "^0.5.0",
		"react": "^19.2.0",
		"core": "*",
		"ai": "workspace:*",
		"tools": "workspace:*"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/react": "^19.2.0",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.2.0",
		"chalk": "^5.2.0",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"ink-testing-library": "^3.0.0",
		"prettier": "^2.8.7",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.3",
		"xo": "^0.53.1"
	},
	"ava": {
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--loader=ts-node/esm"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config"
}
