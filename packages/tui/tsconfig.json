{
	"extends": "@sindresorhus/tsconfig",
	"compilerOptions": {
		"outDir": "dist",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"jsx": "react-jsx",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"noPropertyAccessFromIndexSignature": false,
		"lib": [
			"ES2022"
		]
	},
	"include": [
		"source"
	]
}
